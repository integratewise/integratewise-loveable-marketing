  "body": "\n\n    <header id=\"header\" class=\"fixed top-6 left-0 right-0 z-50 px-4\">\n        <nav class=\"max-w-7xl mx-auto bg-[#1c1c1c]/80 backdrop-blur-md border border-white/10 rounded-2xl px-6 py-3 flex items-center justify-between\">\n            <div class=\"flex items-center gap-2\">\n                <div class=\"w-8 h-8 bg-gradient-to-r from-[#FFE1CC] to-[#FFFFFF] rounded-lg flex items-center justify-center\">\n                    <span class=\"text-[#111111] font-bold text-sm\">IW</span>\n                </div>\n                <span class=\"font-bold text-white\">IntegrateWise</span>\n            </div>\n            <div class=\"hidden lg:flex items-center gap-8\">\n                <a href=\"#\" class=\"text-sm font-medium hover:text-[#ffb22c] transition-colors\">Home</a>\n                <a href=\"#\" class=\"text-sm font-medium hover:text-[#ffb22c] transition-colors\">Platform</a>\n                <a href=\"#\" class=\"text-sm font-medium hover:text-[#ffb22c] transition-colors\">Product</a>\n                <a href=\"#\" class=\"text-sm font-medium hover:text-[#ffb22c] transition-colors\">Twin</a>\n                <a href=\"#\" class=\"text-sm font-medium text-[#ffb22c] border-b border-[#ffb22c]\">Solutions</a>\n                <a href=\"#\" class=\"text-sm font-medium hover:text-[#ffb22c] transition-colors\">Connectors</a>\n                <a href=\"#\" class=\"text-sm font-medium hover:text-[#ffb22c] transition-colors\">Pricing</a>\n                <a href=\"#\" class=\"text-sm font-medium hover:text-[#ffb22c] transition-colors\">About</a>\n            </div>\n            <div class=\"flex items-center gap-4\">\n                <button class=\"hidden md:block text-sm font-medium text-white hover:text-[#ffb22c] transition-colors\">Sign In</button>\n                <button class=\"bg-gradient-to-r from-[#FFE1CC] to-[#FFFFFF] text-[#111111] px-5 py-2 rounded-lg text-sm font-semibold hover:opacity-90 transition-opacity\">\n                    Book a Demo\n                </button>\n            </div>\n        </nav>\n    </header>\n\n    <main>\n        <section id=\"hero-section\" class=\"relative h-[700px] flex flex-col items-center justify-center pt-32 pb-20 px-4 overflow-hidden\">\n            <div class=\"hero-glow\"></div>\n            <div class=\"relative z-10 text-center max-w-5xl mx-auto\">\n                <span class=\"inline-flex items-center gap-2 bg-[#1c1c1c] border border-white/10 px-4 py-1.5 rounded-full text-xs font-semibold text-gray-300 mb-6\">\n                    <i class=\"fas fa-user-circle text-[#ffb22c]\"></i> Universal Personal Operating System\n                </span>\n                <h1 class=\"text-5xl md:text-7xl font-bold mb-6 tracking-tight leading-tight\">\n                    <span class=\"text-white\">Your Entire Life.</span><br>\n                    <span class=\"text-gradient\">One Unified Memory.</span>\n                </h1>\n                <p class=\"text-lg md:text-xl text-gray-400 max-w-3xl mx-auto mb-10 leading-relaxed\">\n                    Personal Space is IntegrateWise's person-first memory system. Connect your tasks, calendar, notes, goals, and habits into one governed Digital Memory that never forgets who you are.\n                </p>\n                <div class=\"flex flex-col sm:flex-row gap-4 justify-center items-center mb-12\">\n                    <button class=\"bg-gradient-to-r from-[#FFE1CC] to-[#FFFFFF] text-[#111111] px-8 py-3.5 rounded-lg text-base font-semibold hover:opacity-90 transition-opacity shadow-lg\">\n                        See Your Unified Life View\n                    </button>\n                    <button class=\"bg-white/5 border border-white/10 text-white px-8 py-3.5 rounded-lg text-base font-semibold hover:bg-white/10 transition-all\">\n                        Book a Demo\n                    </button>\n                </div>\n                <div class=\"flex flex-wrap gap-6 justify-center items-center text-sm text-gray-400\">\n                    <div class=\"flex items-center gap-2\">\n                        <i class=\"fas fa-check-circle text-green-400\"></i>\n                        <span>No more fragmented mind</span>\n                    </div>\n                    <div class=\"flex items-center gap-2\">\n                        <i class=\"fas fa-check-circle text-green-400\"></i>\n                        <span>AI that remembers you</span>\n                    </div>\n                    <div class=\"flex items-center gap-2\">\n                        <i class=\"fas fa-check-circle text-green-400\"></i>\n                        <span>Human-approved actions</span>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        <section id=\"problem-section\" class=\"py-20 px-4 bg-[#0d0d0d]\">\n            <div class=\"max-w-7xl mx-auto\">\n                <div class=\"text-center mb-16\">\n                    <h2 class=\"text-3xl md:text-5xl font-bold mb-6\">\n                        <span class=\"text-white\">Without IntegrateWise:</span><br>\n                        <span class=\"text-gradient\">The Fragmented Mind Problem</span>\n                    </h2>\n                    <p class=\"text-lg text-gray-400 max-w-3xl mx-auto\">\n                        Your personal context is entirely fragmented. You carry the heavy cognitive load of constantly connecting the dots yourself across disconnected apps.\n                    </p>\n                </div>\n\n                <div class=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n                    <div class=\"bg-card rounded-2xl p-8 border-l-4 border-red-500/50\">\n                        <div class=\"w-12 h-12 bg-red-500/10 rounded-lg flex items-center justify-center mb-4\">\n                            <i class=\"fas fa-puzzle-piece text-red-400 text-xl\"></i>\n                        </div>\n                        <h3 class=\"text-xl font-bold mb-3 text-white\">Scattered Context</h3>\n                        <p class=\"text-gray-400 text-sm leading-relaxed\">\n                            Tasks in one app, notes in another, calendar events elsewhere, budget in spreadsheets, health habits in yet another tool—none of them speak the same language.\n                        </p>\n                    </div>\n\n                    <div class=\"bg-card rounded-2xl p-8 border-l-4 border-orange-500/50\">\n                        <div class=\"w-12 h-12 bg-orange-500/10 rounded-lg flex items-center justify-center mb-4\">\n                            <i class=\"fas fa-brain text-orange-400 text-xl\"></i>\n                        </div>\n                        <h3 class=\"text-xl font-bold mb-3 text-white\">Heavy Cognitive Load</h3>\n                        <p class=\"text-gray-400 text-sm leading-relaxed\">\n                            You manually connect the dots between your goals, daily tasks, and habits. The mental overhead is exhausting and unsustainable.\n                        </p>\n                    </div>\n\n                    <div class=\"bg-card rounded-2xl p-8 border-l-4 border-yellow-500/50\">\n                        <div class=\"w-12 h-12 bg-yellow-500/10 rounded-lg flex items-center justify-center mb-4\">\n                            <i class=\"fas fa-robot text-yellow-400 text-xl\"></i>\n                        </div>\n                        <h3 class=\"text-xl font-bold mb-3 text-white\">Amnesic AI</h3>\n                        <p class=\"text-gray-400 text-sm leading-relaxed\">\n                            Every AI interaction starts from scratch. It forgets who you are and what you care about the moment the session ends. You rebuild context every time.\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        <section id=\"how-it-works-section\" class=\"py-20 px-4\">\n            <div class=\"max-w-7xl mx-auto\">\n                <div class=\"text-center mb-16\">\n                    <h2 class=\"text-3xl md:text-5xl font-bold mb-6\">\n                        <span class=\"text-white\">How It Works With</span><br>\n                        <span class=\"text-gradient\">IntegrateWise Personal Space</span>\n                    </h2>\n                    <p class=\"text-lg text-gray-400 max-w-3xl mx-auto\">\n                        When you connect your personal apps, IntegrateWise turns your scattered tasks, calendar events, personal notes, and goals into a governed Digital Memory.\n                    </p>\n                </div>\n\n                <div class=\"grid grid-cols-1 lg:grid-cols-2 gap-8 mb-12\">\n                    <div class=\"bg-card rounded-2xl p-8\">\n                        <div class=\"flex items-start gap-4 mb-6\">\n                            <div class=\"w-12 h-12 bg-gradient-to-r from-[#FFE1CC] to-[#FFFFFF] rounded-lg flex items-center justify-center flex-shrink-0\">\n                                <i class=\"fas fa-circle-nodes text-[#111111] text-xl\"></i>\n                            </div>\n                            <div>\n                                <h3 class=\"text-2xl font-bold mb-2\">Unified Life View</h3>\n                                <p class=\"text-gray-400\">IntegrateWise connects your personal apps—email, calendar, notes, health and finance trackers—and automatically builds a complete, unified profile of your goals, tasks, and relationships.</p>\n                            </div>\n                        </div>\n                        <div class=\"bg-[#111111] rounded-xl p-4 border border-white/5\">\n                            <div class=\"flex items-center justify-between mb-4\">\n                                <div class=\"flex items-center gap-3\">\n                                    <img src=\"https://storage.googleapis.com/uxpilot-auth.appspot.com/avatars/avatar-2.jpg\" alt=\"You\" class=\"w-10 h-10 rounded-full object-cover\">\n                                    <div>\n                                        <div class=\"text-sm font-semibold\">Your Personal Dashboard</div>\n                                        <div class=\"text-xs text-gray-500\">All your context in one place</div>\n                                    </div>\n                                </div>\n                                <div class=\"flex items-center gap-2\">\n                                    <div class=\"w-2 h-2 bg-green-400 rounded-full\"></div>\n                                    <span class=\"text-xs text-green-400 font-semibold\">On Track</span>\n                                </div>\n                            </div>\n                            <div class=\"grid grid-cols-3 gap-3 text-xs mb-3\">\n                                <div>\n                                    <div class=\"text-gray-500\">Today's Focus</div>\n                                    <div class=\"text-lg font-bold text-green-400\">5 tasks</div>\n                                </div>\n                                <div>\n                                    <div class=\"text-gray-500\">Goals Progress</div>\n                                    <div class=\"text-lg font-bold\">68%</div>\n                                </div>\n                                <div>\n                                    <div class=\"text-gray-500\">Sleep Quality</div>\n                                    <div class=\"text-lg font-bold\">7.2hrs</div>\n                                </div>\n                            </div>\n                            <div class=\"border-t border-white/5 pt-3\">\n                                <div class=\"text-xs text-gray-500 mb-2\">Recent Activity</div>\n                                <div class=\"space-y-1.5 text-xs\">\n                                    <div class=\"flex items-center gap-2\">\n                                        <i class=\"fas fa-check-circle text-green-400\"></i>\n                                        <span>Completed: Q1 financial review - 2 hrs ago</span>\n                                    </div>\n                                    <div class=\"flex items-center gap-2\">\n                                        <i class=\"fas fa-calendar text-blue-400\"></i>\n                                        <span>Upcoming: Team sync at 3 PM today</span>\n                                    </div>\n                                    <div class=\"flex items-center gap-2\">\n                                        <i class=\"fas fa-heart text-red-400\"></i>\n                                        <span>Health: Morning workout logged</span>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n\n                    <div class=\"bg-card rounded-2xl p-8\">\n                        <div class=\"flex items-start gap-4 mb-6\">\n                            <div class=\"w-12 h-12 bg-gradient-to-r from-[#FFE1CC] to-[#FFFFFF] rounded-lg flex items-center justify-center flex-shrink-0\">\n                                <i class=\"fas fa-brain text-[#111111] text-xl\"></i>\n                            </div>\n                            <div>\n                                <h3 class=\"text-2xl font-bold mb-2\">Proactive Intelligence</h3>\n                                <p class=\"text-gray-400\">Your AI Twin continuously watches your personal Digital Memory to surface evidence-backed insights. It connects dots across your life that you'd never see manually.</p>\n                            </div>\n                        </div>\n                        <div class=\"space-y-3\">\n                            <div class=\"bg-[#111111] rounded-xl p-4 border border-red-500/30\">\n                                <div class=\"flex items-start gap-3 mb-3\">\n                                    <i class=\"fas fa-exclamation-circle text-red-400 text-lg mt-0.5\"></i>\n                                    <div class=\"flex-1\">\n                                        <div class=\"text-sm font-semibold text-red-300 mb-1\">Health Pattern Alert</div>\n                                        <div class=\"text-xs text-gray-400 mb-2\">Your sleep quality dropped 30% the exact same week your work hours increased 40%</div>\n                                        <div class=\"flex gap-2\">\n                                            <span class=\"text-xs bg-red-500/20 px-2 py-1 rounded-full text-red-300\">Burnout Risk</span>\n                                            <span class=\"text-xs bg-white/5 px-2 py-1 rounded-full\">Evidence-Backed</span>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"bg-[#111111] rounded-xl p-4 border border-yellow-500/30\">\n                                <div class=\"flex items-start gap-3 mb-3\">\n                                    <i class=\"fas fa-lightbulb text-yellow-400 text-lg mt-0.5\"></i>\n                                    <div class=\"flex-1\">\n                                        <div class=\"text-sm font-semibold text-yellow-300 mb-1\">Learning Opportunity</div>\n                                        <div class=\"text-xs text-gray-400 mb-2\">You completed 3 courses on data science but haven't practiced in 2 weeks—momentum at risk</div>\n                                        <div class=\"flex gap-2\">\n                                            <span class=\"text-xs bg-yellow-500/20 px-2 py-1 rounded-full text-yellow-300\">Reminder</span>\n                                            <span class=\"text-xs bg-white/5 px-2 py-1 rounded-full\">Goal: Data Science</span>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"bg-[#111111] rounded-xl p-4 border border-green-500/30\">\n                                <div class=\"flex items-start gap-3\">\n                                    <i class=\"fas fa-trophy text-green-400 text-lg mt-0.5\"></i>\n                                    <div class=\"flex-1\">\n                                        <div class=\"text-sm font-semibold text-green-300 mb-1\">Network Insight</div>\n                                        <div class=\"text-xs text-gray-400 mb-2\">You haven't reached out to Sarah (former colleague) in 6 months—connection may be dormant</div>\n                                        <div class=\"flex gap-2\">\n                                            <span class=\"text-xs bg-green-500/20 px-2 py-1 rounded-full text-green-300\">Reconnect</span>\n                                            <span class=\"text-xs bg-white/5 px-2 py-1 rounded-full\">Last: April 2024</span>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n\n                    <div class=\"bg-card rounded-2xl p-8\">\n                        <div class=\"flex items-start gap-4 mb-6\">\n                            <div class=\"w-12 h-12 bg-gradient-to-r from-[#FFE1CC] to-[#FFFFFF] rounded-lg flex items-center justify-center flex-shrink-0\">\n                                <i class=\"fas fa-shield-check text-[#111111] text-xl\"></i>\n                            </div>\n                            <div>\n                                <h3 class=\"text-2xl font-bold mb-2\">You Stay in Control</h3>\n                                <p class=\"text-gray-400\">The Twin might propose updating your learning path based on a completed course, or drafting a follow-up email to a dormant contact, but it never acts alone. Nothing changes without your explicit approval.</p>\n                            </div>\n                        </div>\n                        <div class=\"bg-[#111111] rounded-xl p-4\">\n                            <div class=\"text-xs text-gray-500 mb-3 flex items-center gap-2\">\n                                <i class=\"fas fa-clock\"></i>\n                                <span>Pending Your Approval (4)</span>\n                            </div>\n                            <div class=\"space-y-3 text-sm\">\n                                <div class=\"bg-white/5 rounded-lg p-3\">\n                                    <div class=\"flex items-start justify-between mb-2\">\n                                        <div class=\"flex-1\">\n                                            <div class=\"font-semibold mb-1\">Update learning path</div>\n                                            <div class=\"text-xs text-gray-400\">Add advanced Python module after course completion</div>\n                                        </div>\n                                        <button class=\"text-xs text-[#ffb22c] font-semibold hover:text-[#ffc44d] transition-colors\">Review</button>\n                                    </div>\n                                </div>\n                                <div class=\"bg-white/5 rounded-lg p-3\">\n                                    <div class=\"flex items-center justify-between\">\n                                        <div>\n                                            <div class=\"font-semibold mb-1\">Draft reconnection email</div>\n                                            <div class=\"text-xs text-gray-400\">To: Sarah Chen - Catch up after 6 months</div>\n                                        </div>\n                                        <button class=\"text-xs text-[#ffb22c] font-semibold hover:text-[#ffc44d] transition-colors\">Review</button>\n                                    </div>\n                                </div>\n                                <div class=\"bg-white/5 rounded-lg p-3\">\n                                    <div class=\"flex items-center justify-between\">\n                                        <div>\n                                            <div class=\"font-semibold mb-1\">Schedule recovery time</div>\n                                            <div class=\"text-xs text-gray-400\">Block calendar for rest—sleep pattern alert</div>\n                                        </div>\n                                        <button class=\"text-xs text-[#ffb22c] font-semibold hover:text-[#ffc44d] transition-colors\">Review</button>\n                                    </div>\n                                </div>\n                                <div class=\"bg-white/5 rounded-lg p-3\">\n                                    <div class=\"flex items-center justify-between\">\n                                        <div>\n                                            <div class=\"font-semibold mb-1\">Adjust budget goal</div>\n                                            <div class=\"text-xs text-gray-400\">Based on Q1 spending patterns</div>\n                                        </div>\n                                        <button class=\"text-xs text-[#ffb22c] font-semibold hover:text-[#ffc44d] transition-colors\">Review</button>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n\n                    <div class=\"bg-card rounded-2xl p-8\">\n                        <div class=\"flex items-start gap-4 mb-6\">\n                            <div class=\"w-12 h-12 bg-gradient-to-r from-[#FFE1CC] to-[#FFFFFF] rounded-lg flex items-center justify-center flex-shrink-0\">\n                                <i class=\"fas fa-layer-group text-[#111111] text-xl\"></i>\n                            </div>\n                            <div>\n                                <h3 class=\"text-2xl font-bold mb-2\">Same Enterprise Architecture</h3>\n                                <p class=\"text-gray-400\">You're not downloading a separate consumer app. You're using the exact same Digital Memory, Workbench, Twin, and Approval model—simply pointed at you.</p>\n                            </div>\n                        </div>\n                        <div class=\"space-y-3\">\n                            <div class=\"text-xs text-gray-500 mb-2\">Connected Personal Apps</div>\n                            <div class=\"flex flex-wrap gap-2\">\n                                <span class=\"text-xs bg-white/5 px-3 py-1.5 rounded-full border border-white/10 flex items-center gap-2\">\n                                    <i class=\"fab fa-google text-red-400\"></i> Gmail\n                                </span>\n                                <span class=\"text-xs bg-white/5 px-3 py-1.5 rounded-full border border-white/10 flex items-center gap-2\">\n                                    <i class=\"fas fa-calendar text-blue-400\"></i> Google Calendar\n                                </span>\n                                <span class=\"text-xs bg-white/5 px-3 py-1.5 rounded-full border border-white/10 flex items-center gap-2\">\n                                    <i class=\"fas fa-check-square text-green-400\"></i> Todoist\n                                </span>\n                                <span class=\"text-xs bg-white/5 px-3 py-1.5 rounded-full border border-white/10 flex items-center gap-2\">\n                                    <i class=\"fas fa-note-sticky text-yellow-400\"></i> Notion\n                                </span>\n                                <span class=\"text-xs bg-white/5 px-3 py-1.5 rounded-full border border-white/10 flex items-center gap-2\">\n                                    <i class=\"fas fa-heart-pulse text-red-400\"></i> Apple Health\n                                </span>\n                                <span class=\"text-xs bg-white/5 px-3 py-1.5 rounded-full border border-white/10 flex items-center gap-2\">\n                                    <i class=\"fas fa-wallet text-purple-400\"></i> Mint\n                                </span>\n                                <span class=\"text-xs bg-white/5 px-3 py-1.5 rounded-full border border-white/10 flex items-center gap-2\">\n                                    <i class=\"fab fa-spotify text-green-400\"></i> Spotify\n                                </span>\n                                <span class=\"text-xs bg-white/5 px-3 py-1.5 rounded-full border border-white/10\">\n                                    +15 more\n                                </span>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        <section id=\"selector-section\" class=\"py-12 px-4 bg-[#0d0d0d] sticky top-24 z-40\">\n            <div class=\"max-w-7xl mx-auto\">\n                <div class=\"text-center mb-8\">\n                    <h3 class=\"text-2xl md:text-3xl font-bold mb-3\">\n                        <span class=\"text-white\">How The Experience</span> <span class=\"text-gradient\">Adapts to You</span>\n                    </h3>\n                    <p class=\"text-gray-400\">Everyone starts with their own private memory. Your Workbench reshapes itself based on what you need to focus on.</p>\n                </div>\n                <div class=\"flex flex-col lg:flex-row gap-6 items-center justify-center\">\n                    <div class=\"text-center\">\n                        <div class=\"text-sm text-gray-400 mb-2\">I am...</div>\n                        <div class=\"pill-selector\">\n                            <div class=\"pill-option active\" data-persona=\"professional\">Professional</div>\n                            <div class=\"pill-option\" data-persona=\"freelancer\">Freelancer</div>\n                            <div class=\"pill-option\" data-persona=\"founder\">Founder</div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        <section id=\"persona-section\" class=\"py-20 px-4\">\n            <div class=\"max-w-7xl mx-auto\">\n                <div class=\"content-section active\" data-persona-content=\"professional\">\n                    <div class=\"bg-card rounded-2xl p-8 mb-8\">\n                        <div class=\"flex items-start gap-4 mb-6\">\n                            <div class=\"w-12 h-12 bg-gradient-to-r from-[#FFE1CC] to-[#FFFFFF] rounded-lg flex items-center justify-center flex-shrink-0\">\n                                <i class=\"fas fa-briefcase text-[#111111] text-xl\"></i>\n                            </div>\n                            <div class=\"flex-1\">\n                                <h3 class=\"text-2xl font-bold mb-2\">For the Individual Professional</h3>\n                                <p class=\"text-gray-400 mb-6\">It acts as a private workspace to track your daily focus, career learning progression, and personal health habits seamlessly alongside your day-to-day work.</p>\n                                <div class=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n                                    <div class=\"bg-[#111111] rounded-lg p-4\">\n                                        <i class=\"fas fa-bullseye text-[#ffb22c] text-2xl mb-3\"></i>\n                                        <h4 class=\"font-semibold mb-2\">Daily Focus</h4>\n                                        <p class=\"text-xs text-gray-400\">Morning briefing shows your top 3-5 priorities across work and personal life</p>\n                                    </div>\n                                    <div class=\"bg-[#111111] rounded-lg p-4\">\n                                        <i class=\"fas fa-graduation-cap text-[#ffb22c] text-2xl mb-3\"></i>\n                                        <h4 clas