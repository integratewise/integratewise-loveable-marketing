  "styles": "\n        body { font-family: 'Inter', sans-serif; background-color: #111111; color: #ffffff; }\n        .text-gradient {\n            background: linear-gradient(90deg, #FFE1CC 0%, #FFFFFF 100%);\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n        }\n        .bg-card { background-color: #1c1c1c; border: 1px solid rgba(255, 255, 255, 0.1); }\n        .bg-card-hover:hover { background-color: #252525; transition: all 0.3s ease; }\n        .hero-glow {\n            position: absolute;\n            top: 50%;\n            left: 50%;\n            transform: translate(-50%, -50%);\n            width: 1000px;\n            height: 1000px;\n            background: radial-gradient(circle, rgba(120, 103, 146, 0.15) 0%, rgba(17, 17, 17, 0) 70%);\n            z-index: 0;\n            pointer-events: none;\n        }\n        ::-webkit-scrollbar { display: none;}\n        .pill-selector {\n            display: inline-flex;\n            padding: 0.25rem;\n            background: rgba(255, 255, 255, 0.05);\n            border-radius: 9999px;\n            border: 1px solid rgba(255, 255, 255, 0.1);\n        }\n        .pill-option {\n            padding: 0.5rem 1.5rem;\n            border-radius: 9999px;\n            cursor: pointer;\n            transition: all 200ms ease;\n            font-size: 0.875rem;\n            font-weight: 500;\n            color: #9ca3af;\n        }\n        .pill-option.active {\n            background: linear-gradient(90deg, #FFE1CC 0%, #FFFFFF 100%);\n            color: #111111;\n            font-weight: 600;\n        }\n        .pill-option:not(.active):hover {\n            background: rgba(255, 255, 255, 0.05);\n            color: #ffffff;\n        }\n        .content-section {\n            opacity: 0;\n            max-height: 0;\n            overflow: hidden;\n            transition: opacity 200ms ease, max-height 200ms ease;\n        }\n        .content-section.active {\n            opacity: 1;\n            max-height: 10000px;\n        }\n    ",
  "twConfigs": "",
  "scripts": [
    "\n        window.addEventListener('load', function() {\n            const roleOptions = document.querySelectorAll('[data-role]');\n            const businessOptions = document.querySelectorAll('[data-business]');\n            const roleContents = document.querySelectorAll('[data-role-content]');\n            const businessContents = document.querySelectorAll('[data-business-content]');\n\n            let currentRole = 'founder';\n            let currentBusiness = 'saas';\n\n            roleOptions.forEach(option => {\n                option.addEventListener('click', function() {\n                    const role = this.getAttribute('data-role');\n                    currentRole = role;\n                    \n                    roleOptions.forEach(opt => opt.classList.remove('active'));\n                    this.classList.add('active');\n                    \n                    roleContents.forEach(content => {\n                        if (content.getAttribute('data-role-content') === role) {\n                            content.classList.add('active');\n                        } else {\n                            content.classList.remove('active');\n                        }\n                    });\n                });\n            });\n\n            businessOptions.forEach(option => {\n                option.addEventListener('click', function() {\n                    const business = this.getAttribute('data-business');\n                    currentBusiness = business;\n                    \n                    businessOptions.forEach(opt => opt.classList.remove('active'));\n                    this.classList.add('active');\n                    \n                    businessContents.forEach(content => {\n                        if (content.getAttribute('data-business-content') === business) {\n                            content.classList.add('active');\n                        } else {\n                            content.classList.remove('active');\n                        }\n                    });\n                });\n            });\n        });\n    "
  ]
}