# Per-repo .envrc TEMPLATE — copy to each repo root, then `direnv allow`.
#
# Cross-repo isolation contract:
# - Repo declares its OWN runtime versions (.tool-versions) and env.
# - Repo's node_modules / .venv / .next live INSIDE the repo only.
# - No `cd ..` traversal; no sibling repo paths referenced.
# - Secrets opt-in: only uncomment if this repo legitimately needs them.

# 1. Runtimes (managed by mise, declared in .tool-versions in this repo)
use mise

# 2. Repo-local Python venv (created by `mise install` or `python -m venv .venv`)
if [ -d .venv ]; then
  source .venv/bin/activate
fi

# 3. Repo-local Node deps — pnpm by default; per-repo node_modules
export NPM_CONFIG_PREFIX="$PWD/.npm-global"
export PATH="$PWD/node_modules/.bin:$PWD/.npm-global/bin:$PATH"

# 4. Per-repo env file (NOT committed). Create `.env.local` in repo root.
dotenv_if_exists .env.local
dotenv_if_exists .env

# 5. Shared secrets — OPT IN. Uncomment only if this repo needs them.
# source_env_if_exists ~/.config/secrets/master.env

# 6. Repo identity (handy for prompts / debug)
export REPO_NAME="${PWD##*/}"
