# Marketing Runtime — IntegrateWise Marketing
use mise

# Bun is available via mise but this repo uses npm (package-lock.json)
# Keep bun in PATH for optional tooling
export PATH="$PWD/node_modules/.bin:$PATH"

# Per-repo env
dotenv_if_exists .env.local
dotenv_if_exists .env

# Repo identity
export REPO_NAME="integratewise-marketing"
