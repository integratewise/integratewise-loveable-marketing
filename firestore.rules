rules_version = '2';

// Public marketing site form submissions.
// - Anyone can CREATE a doc in the three lead collections.
// - No reads, updates, deletes from the client (admin SDK / console only).
// - Basic shape + size validation to deter abuse.

service cloud.firestore {
  match /databases/{database}/documents {

    function isLead(data) {
      return data.size() <= 12
        && (!('work_email' in data) || (data.work_email is string && data.work_email.size() <= 200))
        && (!('email' in data) || (data.email is string && data.email.size() <= 200))
        && (!('name' in data) || (data.name is string && data.name.size() <= 120))
        && (!('company' in data) || (data.company is string && data.company.size() <= 120))
        && (!('notes' in data) || data.notes == null || (data.notes is string && data.notes.size() <= 2000));
    }

    match /demo_requests/{docId} {
      allow create: if isLead(request.resource.data)
        && request.resource.data.work_email is string
        && request.resource.data.work_email.matches('.+@.+\\..+');
      allow read, update, delete: if false;
    }

    match /early_access/{docId} {
      allow create: if isLead(request.resource.data)
        && request.resource.data.email is string
        && request.resource.data.email.matches('.+@.+\\..+');
      allow read, update, delete: if false;
    }

    match /waitlist/{docId} {
      allow create: if isLead(request.resource.data)
        && request.resource.data.email is string
        && request.resource.data.email.matches('.+@.+\\..+');
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
